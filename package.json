{
	"name": "my-monorepo",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check:env": "bun apps/api/src/check-env.ts",
		"dev": "bun --env-file=.env run --filter './apps/*' dev",
		"start:prod": "bun run build && bun --env-file=.env run --parallel --filter './apps/*' start",
		"db:generate": "bun --env-file=.env run --filter @repo/db generate",
		"db:migrate": "bun --env-file=.env run --filter @repo/db migrate",
		"db:test:migrate": "bun packages/db/test/migrate.ts",
		"test:race": "bun apps/api/scripts/test-race-condition.ts",
		"db:push": "bun --env-file=.env run --filter @repo/db push",
		"db:seed": "bun --env-file=.env run --filter @repo/db seed",
		"db:check": "bun --env-file=.env run --filter @repo/db check",
		"db:studio": "bun --env-file=.env run --filter @repo/db studio",
		"test": "bun run --filter '*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "bun run --filter './apps/*' lint",
		"build": "bun run --filter web build"
	}
}
