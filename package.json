{
	"name": "my-monorepo",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check:env": "bun apps/api/src/check-env.ts",
		"dev": "bun --env-file=.env run --filter './apps/*' dev",
		"dev:api": "bun --env-file=.env run --filter api dev",
		"dev:web": "bun --env-file=.env run --filter web dev",
		"db:generate": "bun run --filter @repo/db generate",
		"db:migrate": "bun run --filter @repo/db migrate",
		"db:push": "bun --env-file=.env run --filter @repo/db push",
		"db:seed": "bun --env-file=.env run --filter @repo/db seed",
		"db:studio": "bun run --filter @repo/db studio",
		"test": "bun run --filter api test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "bun run --filter './apps/*' lint",
		"build": "bun run --filter web build"
	}
}
