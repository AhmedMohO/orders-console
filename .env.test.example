# Copy to .env.test; the test database must be created separately.
DATABASE_URL=postgresql://orders_app:CHANGE_ME@localhost:5432/orders_console_test
# Cleanup compares this target with DATABASE_URL from the root .env.
API_PORT=4001
API_URL=http://localhost:4001
APP_ORIGIN=http://localhost:2001
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
AUTH_COOKIE=orders_access
TOKEN_SECONDS=900
NODE_ENV=test
# Test cookies use HTTP without Secure; API clients must send APP_ORIGIN as Origin.
