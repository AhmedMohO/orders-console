DATABASE_URL=postgresql://orders_app:CHANGE_ME@localhost:5432/orders_console_test
# Used to reject cleanup against the development target, even through another host alias.
DEVELOPMENT_DATABASE_URL=postgresql://orders_app:CHANGE_ME@localhost:5432/orders_console
API_PORT=4001
API_URL=http://localhost:4001
APP_ORIGIN=http://localhost:2001
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
NODE_ENV=test