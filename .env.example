# API
# Copy to .env at the repository root; never commit real credentials.
DATABASE_URL=postgresql://orders_app:CHANGE_ME@localhost:5432/orders_console
API_PORT=4000
APP_ORIGIN=http://localhost:3000
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
NODE_ENV=development
# Development uses HTTP without Secure cookies. Production requires HTTPS and NODE_ENV=production.

# Front
API_URL=http://localhost:4000
# Next proxies relative /api/* to this API origin; do not append /api here.
